# =============================================
# KTX 5S AI — Git Ignore Rules (Backend + Frontend)
# =============================================

# Node.js / Next.js Frontend
node_modules/
**/node_modules/
.next/
**/.next/
.next-build/
**/.next-build/
out/
ktx5s-frontend/out/
*.tsbuildinfo
ktx5s-frontend/ktx5s-frontend/
ktx5s-frontend.zip

# Virtual Environment (Python packages - không bao giờ push lên Git)
venv/
backend/venv/
*/venv/
.venv/
env/

# Environment Variables & Secrets (Bảo vệ API Key và Password)
.env
backend/.env
1.env
*.env
!*.env.example
.env.local

# Python Cache & Bytecode
__pycache__/
*/__pycache__/
*/**/__pycache__/
*.pyc
*.pyo
*.pyd

# Local uploads & temporary test files
static/uploads/
backend/static/uploads/
uploads/
test_ai.py
*.db
*.log

# Visual Studio & SSMS temporary files
.vs/
*.suo
*.user
*.ssms_suo
.idea/
.vscode/

# OS metadata
Thumbs.db
Desktop.ini
.DS_Store
