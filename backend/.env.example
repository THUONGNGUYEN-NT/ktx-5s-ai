# =============================================
# KTX 5S AI — Backend Environment Variables
# Sao chép file này thành .env và điền giá trị thật vào
# =============================================

# --- SQL Server ---
# Nếu dùng SQL Server cài local (Windows Authentication):
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=localhost
DB_NAME=ktx5s_db
DB_USERNAME=sa
DB_PASSWORD=your_password_here
# Kết quả: mssql+pyodbc://sa:password@localhost/ktx5s_db?driver=ODBC+Driver+17+for+SQL+Server

# --- Gemini AI API ---
# Lấy key tại: https://aistudio.google.com/app/apikey (miễn phí)
GEMINI_API_KEY=your_gemini_api_key_here

# --- Cloud Storage (ảnh) ---
# Lấy tại: https://cloudinary.com (free tier 25GB)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- App Config ---
APP_NAME=KTX 5S AI
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=change_this_to_a_random_secret_key

# --- Cấu hình gửi Email thực tế (OTP Khôi phục mật khẩu) ---
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_SENDER_NAME=KTX 5S AI — Trung tâm Quản lý KTX
